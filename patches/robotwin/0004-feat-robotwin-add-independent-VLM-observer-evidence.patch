From ff70562a3c73cdef8b13dda8e0a79371bbdb6bdb Mon Sep 17 00:00:00 2001
From: Du Hangyu <770240437@qq.com>
Date: Thu, 13 Aug 2026 10:10:07 +0800
Subject: [PATCH] feat(robotwin): add independent VLM observer evidence

---
 .../script/eval_lerobot_torch_pi05.py         | 46 ++++++++++++++-----
 .../Robotwin/script/pi05_logiv_execution.py   | 10 ++++
 .../tests/test_pi05_logiv_execution.py        | 18 ++++++++
 3 files changed, 62 insertions(+), 12 deletions(-)

diff --git a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
index 2010cbb..e1c6708 100644
--- a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
+++ b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
@@ -29,6 +29,7 @@ from script.pi05_logiv_options import (
 )
 from script.pi05_logiv_execution import (
     RecedingHorizonMacroExecutor,
+    attach_observer_view,
     collect_fresh_evidence,
 )
 
@@ -253,10 +254,18 @@ def _execute_logiv_chunk(TASK_ENV, model, observation, prompt, action_chunk_step
 
 
 def _collect_fresh_logiv_evidence(TASK_ENV):
-    return collect_fresh_evidence(
+    observation = collect_fresh_evidence(
         advance_time=TASK_ENV.scene.step,
         observe=TASK_ENV.get_obs,
     )
+    return _attach_logiv_observer_view(TASK_ENV, observation)
+
+
+def _attach_logiv_observer_view(TASK_ENV, observation):
+    return attach_observer_view(
+        observation,
+        observe_world=TASK_ENV.cameras.get_observer_rgb,
+    )
 
 
 def eval_logiv_policy(
@@ -363,21 +372,34 @@ def eval_logiv_policy(
         )
         try:
             outcome = controller.run(
-                initial_observation=observation,
-                dispatch=lambda prompt: _execute_logiv_chunk(
-                    TASK_ENV, model, TASK_ENV.get_obs(), prompt, action_chunk_steps
+                initial_observation=_attach_logiv_observer_view(
+                    TASK_ENV, observation
+                ),
+                dispatch=lambda prompt: _attach_logiv_observer_view(
+                    TASK_ENV,
+                    _execute_logiv_chunk(
+                        TASK_ENV, model, TASK_ENV.get_obs(), prompt, action_chunk_steps
+                    ),
                 ),
                 collect_evidence=lambda: _collect_fresh_logiv_evidence(TASK_ENV),
-                dispatch_with_mode=lambda prompt, mode: _execute_logiv_chunk(
+                dispatch_with_mode=lambda prompt, mode: _attach_logiv_observer_view(
                     TASK_ENV,
-                    model,
-                    TASK_ENV.get_obs(),
-                    prompt,
-                    repair_action_chunk_steps
-                    if mode == "REPAIR"
-                    else action_chunk_steps,
+                    _execute_logiv_chunk(
+                        TASK_ENV,
+                        model,
+                        TASK_ENV.get_obs(),
+                        prompt,
+                        repair_action_chunk_steps
+                        if mode == "REPAIR"
+                        else action_chunk_steps,
+                    ),
+                ),
+                dispatch_with_context=lambda prompt, mode, active: (
+                    _attach_logiv_observer_view(
+                        TASK_ENV,
+                        macro_executor.dispatch(prompt, mode, active),
+                    )
                 ),
-                dispatch_with_context=macro_executor.dispatch,
                 native_success=lambda: bool(TASK_ENV.eval_success),
                 budget_exhausted=lambda: TASK_ENV.take_action_cnt >= TASK_ENV.step_lim,
                 base_prompt=str(instruction),
diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
index a12f952..547128f 100644
--- a/third_party/Robotwin/script/pi05_logiv_execution.py
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -1,3 +1,13 @@
+from copy import deepcopy
+
+
+def attach_observer_view(observation, *, observe_world):
+    """Add an independent RGB view to VLM evidence without changing policy input."""
+    evidence = deepcopy(observation)
+    evidence["observation"]["observer_camera"] = {"rgb": observe_world()}
+    return evidence
+
+
 def collect_fresh_evidence(*, advance_time, observe):
     """Advance the simulator safely so an UNKNOWN retry uses a new frame."""
     advance_time()
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
index f7af3f9..d16333b 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_execution.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -2,11 +2,29 @@ import unittest
 
 from script.pi05_logiv_execution import (
     RecedingHorizonMacroExecutor,
+    attach_observer_view,
     collect_fresh_evidence,
 )
 
 
 class RecedingHorizonMacroExecutorTest(unittest.TestCase):
+    def test_observer_view_is_attached_only_to_vlm_evidence(self):
+        policy_observation = {
+            "observation": {"head_camera": {"rgb": "head"}}
+        }
+
+        evidence = attach_observer_view(
+            policy_observation,
+            observe_world=lambda: "independent-world-view",
+        )
+
+        self.assertIsNot(evidence, policy_observation)
+        self.assertNotIn("observer_camera", policy_observation["observation"])
+        self.assertEqual(
+            evidence["observation"]["observer_camera"]["rgb"],
+            "independent-world-view",
+        )
+
     def test_unknown_retry_advances_simulation_before_observing(self):
         calls = []
 
