+import json
+import os
+from pathlib import Path
+
+
+def logiv_python_path(logiv_root):
+    return os.path.join(str(logiv_root), "src")
+
+
+def setup_episode(task_env, args, *, episode_index, seed):
+    """Build the requested test scene without selecting or substituting it."""
+    task_env.setup_demo(
+        now_ep_num=episode_index,
+        seed=seed,
+        is_test=True,
+        **args,
+    )
+
+
+def resolve_logiv_options(usr_args):
+    logiv_root = usr_args.get("logiv_root")
+    val_binary = usr_args.get("val_binary")
+    if not logiv_root or not val_binary:
+        raise ValueError("logiv_root and val_binary are required")
+    action_chunk_steps = int(usr_args.get("action_chunk_steps", 50))
+    repair_action_chunk_steps = int(
+        usr_args.get("repair_action_chunk_steps", action_chunk_steps)
+    )
+    vlm_image_detail = str(usr_args.get("vlm_image_detail", "low"))
+    max_gpt4o_retries = int(usr_args.get("max_gpt4o_retries", 2))
+    base_stall_observations = int(usr_args.get("base_stall_observations", 4))
+    min_base_dispatches = int(usr_args.get("min_base_dispatches", 0))
+    raw_dag_from_start = usr_args.get("dag_from_start", False)
+    dag_from_start = (
+        raw_dag_from_start.strip().lower() == "true"
+        if isinstance(raw_dag_from_start, str)
+        else bool(raw_dag_from_start)
+    )
+    raw_preserve_repair_prompt = usr_args.get(
+        "preserve_original_repair_prompt", False
+    )
+    preserve_original_repair_prompt = (
+        raw_preserve_repair_prompt.strip().lower() == "true"
+        if isinstance(raw_preserve_repair_prompt, str)
+        else bool(raw_preserve_repair_prompt)
+    )
+    use_registered_dag_prompts = (
+        str(usr_args.get("use_registered_dag_prompts", False)).strip().lower()
+        == "true"
+    )
+    raw_policy_replan_steps = usr_args.get("policy_replan_steps")
+    policy_replan_steps = (
+        None
+        if raw_policy_replan_steps in {None, ""}
+        else int(raw_policy_replan_steps)
+    )
+    raw_repair_cfn_path = usr_args.get("repair_cfn_path")
+    repair_cfn_path = (
+        None if raw_repair_cfn_path in {None, ""} else str(raw_repair_cfn_path)
+    )
+    raw_stage_stalls = usr_args.get("stage_stall_observations")
+    if isinstance(raw_stage_stalls, str):
+        raw_stage_stalls = json.loads(raw_stage_stalls)
+    stage_stall_observations = (
+        None
+        if raw_stage_stalls is None
+        else [int(value) for value in raw_stage_stalls]
+    )
+    if action_chunk_steps < 1 or action_chunk_steps > 50:
+        raise ValueError("action_chunk_steps must be in [1, 50]")
+    if (
+        repair_action_chunk_steps < 1
+        or repair_action_chunk_steps > action_chunk_steps
+    ):
+        raise ValueError(
+            "repair_action_chunk_steps must be in [1, action_chunk_steps]"
+        )
+    if vlm_image_detail not in {"low", "high"}:
+        raise ValueError("vlm_image_detail must be 'low' or 'high'")
+    if max_gpt4o_retries < 0:
+        raise ValueError("max_gpt4o_retries must be nonnegative")
+    if base_stall_observations < 1:
+        raise ValueError("base_stall_observations must be positive")
+    if min_base_dispatches < 0:
+        raise ValueError("min_base_dispatches must be nonnegative")
+    if policy_replan_steps is not None and (
+        policy_replan_steps < 1 or policy_replan_steps > action_chunk_steps
+    ):
+        raise ValueError("policy_replan_steps must be in [1, action_chunk_steps]")
+    if stage_stall_observations is not None and (
+        not stage_stall_observations
+        or any(value < 1 for value in stage_stall_observations)
+    ):
+        raise ValueError("stage_stall_observations must contain positive values")
+    if repair_cfn_path is not None and not Path(repair_cfn_path).is_file():
+        raise ValueError("repair_cfn_path must name an existing file")
+    return (
+        str(logiv_root),
+        str(val_binary),
+        action_chunk_steps,
+        repair_action_chunk_steps,
+        vlm_image_detail,
+        max_gpt4o_retries,
+        base_stall_observations,
+        stage_stall_observations,
+        min_base_dispatches,
+        dag_from_start,
+        preserve_original_repair_prompt,
+        use_registered_dag_prompts,
+        policy_replan_steps,
+        repair_cfn_path,
+    )
