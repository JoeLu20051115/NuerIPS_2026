+import inspect
+import unittest
+
+from script import pi05_logiv_options
+
+
+class LogivOriginOptionsTest(unittest.TestCase):
+    def test_runtime_options_expose_no_episode_selector(self):
+        source = inspect.getsource(pi05_logiv_options)
+        forbidden = (
+            "accepted_" + "seeds",
+            "accepted_" + "instructions",
+            "frozen_" + "episode",
+        )
+        self.assertFalse(any(value in source for value in forbidden))
+
+    def test_episode_setup_uses_the_requested_seed_once(self):
+        class FakeTaskEnv:
+            def __init__(self):
+                self.calls = []
+
+            def setup_demo(self, **kwargs):
+                self.calls.append(kwargs)
+
+        env = FakeTaskEnv()
+        self.assertTrue(hasattr(pi05_logiv_options, "setup_episode"))
+        pi05_logiv_options.setup_episode(
+            env,
+            {"task_name": "turn_switch"},
+            episode_index=2,
+            seed=14,
+        )
+        self.assertEqual(
+            env.calls,
+            [
+                {
+                    "task_name": "turn_switch",
+                    "now_ep_num": 2,
+                    "seed": 14,
+                    "is_test": True,
+                }
+            ],
+        )
+
+    def test_resolves_monitor_and_repair_options(self):
+        resolved = pi05_logiv_options.resolve_logiv_options(
+            {
+                "logiv_root": "/repo",
+                "val_binary": "/repo/Validate",
+                "action_chunk_steps": 25,
+                "repair_action_chunk_steps": 10,
+                "vlm_image_detail": "high",
+                "max_gpt4o_retries": 3,
+                "base_stall_observations": 4,
+                "stage_stall_observations": "[4, 4, 1]",
+                "min_base_dispatches": 6,
+                "dag_from_start": True,
+                "preserve_original_repair_prompt": True,
+                "use_registered_dag_prompts": True,
+                "policy_replan_steps": 10,
+                "repair_cfn_path": __file__,
+            }
+        )
+        self.assertEqual(
+            resolved,
+            (
+                "/repo",
+                "/repo/Validate",
+                25,
+                10,
+                "high",
+                3,
+                4,
+                [4, 4, 1],
+                6,
+                True,
+                True,
+                True,
+                10,
+                __file__,
+            ),
+        )
+
+    def test_rejects_invalid_runtime_bounds(self):
+        common = {"logiv_root": "/repo", "val_binary": "/repo/Validate"}
+        with self.assertRaisesRegex(ValueError, "action_chunk_steps"):
+            pi05_logiv_options.resolve_logiv_options(
+                {**common, "action_chunk_steps": 0}
+            )
+        with self.assertRaisesRegex(ValueError, "repair_action_chunk_steps"):
+            pi05_logiv_options.resolve_logiv_options(
+                {
+                    **common,
+                    "action_chunk_steps": 25,
+                    "repair_action_chunk_steps": 30,
+                }
+            )
+        with self.assertRaisesRegex(ValueError, "vlm_image_detail"):
+            pi05_logiv_options.resolve_logiv_options(
+                {**common, "vlm_image_detail": "ultra"}
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
