@@ -0,0 +1,194 @@
+import unittest
+from pathlib import Path
+import tempfile
+
+from script.pi05_logiv_execution import (
+    RecedingHorizonMacroExecutor,
+    attach_observer_view,
+    collect_fresh_evidence,
+    relativize_vlm_audit_records,
+)
+
+
+class RecedingHorizonMacroExecutorTest(unittest.TestCase):
+    def test_vlm_audit_records_are_confined_to_the_episode_output(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory).resolve()
+            image = root / "vlm_audit" / "task-seed-epoch-000.png"
+            records = (
+                {
+                    "epoch": 0,
+                    "path": str(image),
+                    "camera_order": ["current/head_camera"],
+                    "sha256": "a" * 64,
+                },
+            )
+
+            relative = relativize_vlm_audit_records(records, root)
+
+            self.assertEqual(
+                relative[0]["path"],
+                "vlm_audit/task-seed-epoch-000.png",
+            )
+            with self.assertRaisesRegex(ValueError, "outside save_dir"):
+                relativize_vlm_audit_records(
+                    ({**records[0], "path": str(root.parent / "escape.png")},),
+                    root,
+                )
+
+    def test_observer_view_is_attached_only_to_vlm_evidence(self):
+        policy_observation = {
+            "observation": {"head_camera": {"rgb": "head"}}
+        }
+
+        evidence = attach_observer_view(
+            policy_observation,
+            observe_world=lambda: "independent-world-view",
+        )
+
+        self.assertIsNot(evidence, policy_observation)
+        self.assertNotIn("observer_camera", policy_observation["observation"])
+        self.assertEqual(
+            evidence["observation"]["observer_camera"]["rgb"],
+            "independent-world-view",
+        )
+
+    def test_unknown_retry_advances_simulation_before_observing(self):
+        calls = []
+
+        observation = collect_fresh_evidence(
+            advance_time=lambda: calls.append("advance"),
+            observe=lambda: calls.append("observe") or {"frame": 2},
+        )
+
+        self.assertEqual(calls, ["advance", "observe"])
+        self.assertEqual(observation, {"frame": 2})
+
+    def test_repair_resamples_after_each_observation_boundary(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            start = len(samples) * 100
+            return list(range(start, start + 50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: len(executed),
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("grasp", "REPAIR", 0)
+        executor.dispatch("grasp", "REPAIR", 0)
+        executor.dispatch("handover", "REPAIR", 1)
+
+        self.assertEqual(len(samples), 3)
+        self.assertEqual(executed[:10], list(range(100, 110)))
+        self.assertEqual(executed[10:20], list(range(200, 210)))
+        self.assertEqual(executed[20:], list(range(300, 310)))
+
+    def test_mode_change_starts_a_new_certified_macro(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            return list(range(50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: None,
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("same prompt", "BASE_MONITORED", 0)
+        executor.dispatch("same prompt", "REPAIR", 0)
+
+        self.assertEqual(len(samples), 2)
+        self.assertEqual(len(executed), 60)
+
+    def test_dag_node_executes_one_complete_policy_macro_before_gate(self):
+        executed = []
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=lambda prompt, observation: list(range(50)),
+            take_action=executed.append,
+            observe=lambda: None,
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("ready node", "DAG_EXECUTION", 0)
+
+        self.assertEqual(executed, list(range(50)))
+
+    def test_node_can_replan_policy_internally_without_extra_vlm_gate(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            start = len(samples) * 100
+            return list(range(start, start + 50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: len(executed),
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=50,
+            policy_replan_steps=10,
+        )
+
+        final_observation = executor.dispatch("task", "DAG_EXECUTION", 0)
+
+        self.assertEqual(len(samples), 5)
+        self.assertEqual([observation for _, observation in samples], [0, 10, 20, 30, 40])
+        self.assertEqual(len(executed), 50)
+        self.assertEqual(executed[:10], list(range(100, 110)))
+        self.assertEqual(executed[-10:], list(range(500, 510)))
+        self.assertEqual(final_observation, 50)
+
+    def test_cfn_sampler_is_used_for_every_pddl_controlled_node(self):
+        samplers = []
+        executed = []
+
+        def base_sample(prompt, observation):
+            samplers.append(("pi05", prompt))
+            return list(range(50))
+
+        def repair_sample(prompt, observation):
+            samplers.append(("cfn", prompt))
+            return list(range(100, 150))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=base_sample,
+            sample_repair_actions=repair_sample,
+            take_action=executed.append,
+            observe=lambda: None,
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("ready node", "DAG_EXECUTION", 0)
+        executor.dispatch("local repair", "REPAIR", 0)
+
+        self.assertEqual(
+            samplers,
+            [("cfn", "ready node"), ("cfn", "local repair")],
+        )
+        self.assertEqual(executed[:50], list(range(100, 150)))
+        self.assertEqual(executed[50:], list(range(100, 110)))
+
+
+if __name__ == "__main__":
+    unittest.main()
