 import unittest
+from pathlib import Path
+import tempfile
 
 from script.pi05_logiv_execution import (
     RecedingHorizonMacroExecutor,
     attach_observer_view,
     collect_fresh_evidence,
+    relativize_vlm_audit_records,
 )
 
 
 class RecedingHorizonMacroExecutorTest(unittest.TestCase):
+    def test_vlm_audit_records_are_confined_to_the_episode_output(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory).resolve()
+            image = root / "vlm_audit" / "task-seed-epoch-000.png"
+            records = (
+                {
+                    "epoch": 0,
+                    "path": str(image),
+                    "camera_order": ["current/head_camera"],
+                    "sha256": "a" * 64,
+                },
+            )
+
+            relative = relativize_vlm_audit_records(records, root)
+
+            self.assertEqual(
+                relative[0]["path"],
+                "vlm_audit/task-seed-epoch-000.png",
+            )
+            with self.assertRaisesRegex(ValueError, "outside save_dir"):
+                relativize_vlm_audit_records(
+                    ({**records[0], "path": str(root.parent / "escape.png")},),
+                    root,
+                )
+
     def test_observer_view_is_attached_only_to_vlm_evidence(self):
         policy_observation = {
             "observation": {"head_camera": {"rgb": "head"}}
