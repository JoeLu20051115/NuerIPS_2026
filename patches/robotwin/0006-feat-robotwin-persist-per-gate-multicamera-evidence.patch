diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
index aee0201..87908d6 100644
--- a/third_party/Robotwin/script/pi05_logiv_execution.py
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -1,4 +1,20 @@
 from copy import deepcopy
+from pathlib import Path
+
+
+def relativize_vlm_audit_records(records, save_dir):
+    """Serialize audit paths without allowing an episode to escape its output."""
+    root = Path(save_dir).resolve()
+    serialized = []
+    for record in records:
+        value = dict(record)
+        try:
+            relative = Path(value["path"]).resolve().relative_to(root)
+        except (KeyError, ValueError):
+            raise ValueError("VLM audit path is outside save_dir") from None
+        value["path"] = relative.as_posix()
+        serialized.append(value)
+    return serialized
 
 
