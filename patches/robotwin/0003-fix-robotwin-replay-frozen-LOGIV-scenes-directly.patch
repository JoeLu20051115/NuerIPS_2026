diff --git a/third_party/Robotwin/script/pi05_logiv_options.py b/third_party/Robotwin/script/pi05_logiv_options.py
index a3edf8d..50ded9e 100644
--- a/third_party/Robotwin/script/pi05_logiv_options.py
+++ b/third_party/Robotwin/script/pi05_logiv_options.py
@@ -5,6 +5,16 @@ def logiv_python_path(logiv_root):
     return os.path.join(str(logiv_root), "src")
 
 
+def setup_frozen_episode(task_env, args, *, episode_index, seed):
+    """Build exactly the frozen test scene, without replaying the expert policy."""
+    task_env.setup_demo(
+        now_ep_num=episode_index,
+        seed=seed,
+        is_test=True,
+        **args,
+    )
+
+
 def resolve_logiv_options(usr_args):
     test_num = int(usr_args.get("test_num", 100))
     accepted_seeds = [int(seed) for seed in usr_args.get("accepted_seeds", [])]
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_options.py b/third_party/Robotwin/tests/test_pi05_logiv_options.py
index 258ba72..4a3bfc4 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_options.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_options.py
@@ -1,9 +1,47 @@
 import unittest
 
-from script.pi05_logiv_options import logiv_python_path, resolve_logiv_options
+from script.pi05_logiv_options import (
+    logiv_python_path,
+    resolve_logiv_options,
+    setup_frozen_episode,
+)
 
 
 class LogivOptionsTest(unittest.TestCase):
+    def test_frozen_episode_setup_never_executes_expert_policy(self):
+        class FakeTaskEnv:
+            def __init__(self):
+                self.calls = []
+
+            def setup_demo(self, **kwargs):
+                self.calls.append(("setup_demo", kwargs))
+
+            def play_once(self):
+                raise AssertionError("frozen protocol must not replay the expert")
+
+        env = FakeTaskEnv()
+        setup_frozen_episode(
+            env,
+            {"task_name": "place_dual_shoes"},
+            episode_index=1,
+            seed=100002,
+        )
+
+        self.assertEqual(
+            env.calls,
+            [
+                (
+                    "setup_demo",
+                    {
+                        "task_name": "place_dual_shoes",
+                        "now_ep_num": 1,
+                        "seed": 100002,
+                        "is_test": True,
+                    },
+                )
+            ],
+        )
+
     def test_src_layout_package_path_is_explicit(self):
         self.assertEqual(logiv_python_path("/repo"), "/repo/src")
 
