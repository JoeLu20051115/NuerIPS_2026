+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -27,6 +27,7 @@ class RecedingHorizonMacroExecutor:
         native_success,
         base_chunk_steps,
         repair_observation_steps,
+        policy_replan_steps=None,
     ):
         self.sample_actions = sample_actions
         self.sample_repair_actions = sample_repair_actions
@@ -35,31 +36,49 @@ class RecedingHorizonMacroExecutor:
         self.native_success = native_success
         self.base_chunk_steps = int(base_chunk_steps)
         self.repair_observation_steps = int(repair_observation_steps)
+        self.policy_replan_steps = (
+            None if policy_replan_steps is None else int(policy_replan_steps)
+        )
+        if self.policy_replan_steps is not None and self.policy_replan_steps < 1:
+            raise ValueError("policy_replan_steps must be positive")
         self._key = None
         self._actions = []
 
     def dispatch(self, prompt, mode, active_frontier):
         key = (str(prompt), str(mode), active_frontier)
+        sampler = (
+            self.sample_repair_actions
+            if mode in {"DAG_EXECUTION", "REPAIR"}
+            and self.sample_repair_actions is not None
+            else self.sample_actions
+        )
+        steps = (
+            self.base_chunk_steps
+            if mode in {"BASE_MONITORED", "DAG_EXECUTION"}
+            else self.repair_observation_steps
+        )
+        if self.policy_replan_steps is not None:
+            remaining = steps
+            while remaining > 0 and not self.native_success():
+                actions = list(sampler(prompt, self.observe()))
+                count = min(self.policy_replan_steps, remaining, len(actions))
+                for action in actions[:count]:
+                    self.take_action(action)
+                    if self.native_success():
+                        break
+                remaining -= count
+                if count == 0:
+                    break
+            return self.observe()
         # A repair dispatch is a receding-horizon local edit: after each
         # observation boundary, sample a fresh short action prefix from the
         # current image.  Replaying the unexecuted tail of the old 50-step
         # macro ignores the very evidence that triggered local replanning.
         if mode == "REPAIR" or key != self._key or not self._actions:
             self._key = key
-            sampler = (
-                self.sample_repair_actions
-                if mode in {"DAG_EXECUTION", "REPAIR"}
-                and self.sample_repair_actions is not None
-                else self.sample_actions
-            )
             self._actions = list(sampler(prompt, self.observe()))[
                 : self.base_chunk_steps
             ]
-        steps = (
-            self.base_chunk_steps
-            if mode in {"BASE_MONITORED", "DAG_EXECUTION"}
-            else self.repair_observation_steps
-        )
         for _ in range(min(steps, len(self._actions))):
             self.take_action(self._actions.pop(0))
             if self.native_success():
