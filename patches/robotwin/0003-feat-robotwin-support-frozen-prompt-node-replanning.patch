@@ -101,6 +101,34 @@ class RecedingHorizonMacroExecutorTest(unittest.TestCase):
 
         self.assertEqual(executed, list(range(50)))
 
+    def test_node_can_replan_policy_internally_without_extra_vlm_gate(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            start = len(samples) * 100
+            return list(range(start, start + 50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: len(executed),
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=50,
+            policy_replan_steps=10,
+        )
+
+        final_observation = executor.dispatch("task", "DAG_EXECUTION", 0)
+
+        self.assertEqual(len(samples), 5)
+        self.assertEqual([observation for _, observation in samples], [0, 10, 20, 30, 40])
+        self.assertEqual(len(executed), 50)
+        self.assertEqual(executed[:10], list(range(100, 110)))
+        self.assertEqual(executed[-10:], list(range(500, 510)))
+        self.assertEqual(final_observation, 50)
+
     def test_cfn_sampler_is_used_for_every_pddl_controlled_node(self):
         samplers = []
         executed = []
