+import unittest
+
+from script.discover_logiv_seed_pool import discover_seed_pool
+
+
+class DiscoverLogivSeedPoolTest(unittest.TestCase):
+    def test_discovers_exact_accepted_scenes_and_deterministic_instructions(self):
+        class FakeEnv:
+            def __init__(self):
+                self.seed = None
+                self.plan_success = False
+                self.closed = []
+
+            def setup_demo(self, **kwargs):
+                self.seed = kwargs["seed"]
+                self.plan_success = self.seed % 2 == 0
+
+            def play_once(self):
+                return {"info": {"seed": str(self.seed)}}
+
+            def check_success(self):
+                return self.plan_success
+
+            def close_env(self, **kwargs):
+                self.closed.append(self.seed)
+
+        def descriptions(task, episodes, count):
+            self.assertEqual(task, "task_a")
+            self.assertEqual(count, 1)
+            seed = episodes[0]["seed"]
+            return [{"unseen": [f"instruction-{seed}"], "seen": []}]
+
+        env = FakeEnv()
+        pool = discover_seed_pool(
+            env,
+            {"task_name": "task_a"},
+            task_name="task_a",
+            start_seed=100000,
+            count=3,
+            instruction_type="unseen",
+            generate_descriptions=descriptions,
+        )
+
+        self.assertEqual(
+            [record["seed"] for record in pool["candidates"]],
+            [100000, 100002, 100004],
+        )
+        self.assertEqual(
+            [record["instruction"] for record in pool["candidates"]],
+            ["instruction-100000", "instruction-100002", "instruction-100004"],
+        )
+        self.assertEqual(pool["raw_seed_count"], 5)
+        self.assertEqual(env.closed, [100000, 100001, 100002, 100003, 100004])
+
+
+if __name__ == "__main__":
+    unittest.main()
