+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import random
+
+import numpy as np
+
+
+def _instruction_for_scene(
+    task_name,
+    episode_info,
+    instruction_type,
+    generate_descriptions,
+    seed,
+):
+    python_state = random.getstate()
+    numpy_state = np.random.get_state()
+    try:
+        random.seed(seed)
+        np.random.seed(seed)
+        generated = generate_descriptions(task_name, [episode_info], 1)
+    finally:
+        random.setstate(python_state)
+        np.random.set_state(numpy_state)
+    if not generated or not generated[0].get(instruction_type):
+        raise RuntimeError(f"no {instruction_type} instruction for {task_name} seed {seed}")
+    return str(generated[0][instruction_type][0])
+
+
+def discover_seed_pool(
+    task_env,
+    args,
+    *,
+    task_name,
+    start_seed,
+    count,
+    instruction_type,
+    generate_descriptions,
+    max_raw_seeds=None,
+    retry_exceptions=(),
+):
+    if count < 1:
+        raise ValueError("count must be positive")
+    limit = count * 5 if max_raw_seeds is None else int(max_raw_seeds)
+    if limit < count:
+        raise ValueError("max_raw_seeds must be at least count")
+    candidates = []
+    seed = int(start_seed)
+    scanned = 0
+    while len(candidates) < count and scanned < limit:
+        current = seed
+        seed += 1
+        scanned += 1
+        try:
+            task_env.setup_demo(
+                now_ep_num=len(candidates),
+                seed=current,
+                is_test=True,
+                **args,
+            )
+            episode = task_env.play_once()
+            accepted = bool(task_env.plan_success and task_env.check_success())
+        except retry_exceptions:
+            accepted = False
+            episode = None
+        finally:
+            task_env.close_env()
+        if not accepted:
+            continue
+        info = episode.get("info", {})
+        instruction = _instruction_for_scene(
+            task_name,
+            info,
+            instruction_type,
+            generate_descriptions,
+            current,
+        )
+        candidates.append(
+            {
+                "task": task_name,
+                "seed": current,
+                "instruction": instruction,
+                "episode_info": info,
+            }
+        )
+    if len(candidates) != count:
+        raise RuntimeError(
+            f"found only {len(candidates)}/{count} accepted scenes after {scanned} raw seeds"
+        )
+    return {
+        "task": task_name,
+        "start_seed": int(start_seed),
+        "candidate_count": len(candidates),
+        "raw_seed_count": scanned,
+        "instruction_type": instruction_type,
+        "candidates": candidates,
+    }
+
+
+def _build_environment(task_name, task_config):
+    import yaml
+
+    from envs import CONFIGS_PATH
+    from script.eval_lerobot_torch_pi05 import class_decorator, get_embodiment_config
+
+    with Path("task_config", f"{task_config}.yml").open(encoding="utf-8") as stream:
+        args = yaml.load(stream.read(), Loader=yaml.FullLoader)
+    args.update(
+        task_name=task_name,
+        task_config=task_config,
+        ckpt_setting="unified_50tasks",
+        eval_mode=True,
+        policy_name="pi05",
+        eval_video_log=False,
+    )
+    with Path(CONFIGS_PATH, "_embodiment_config.yml").open(encoding="utf-8") as stream:
+        embodiments = yaml.load(stream.read(), Loader=yaml.FullLoader)
+    with Path(CONFIGS_PATH, "_camera_config.yml").open(encoding="utf-8") as stream:
+        cameras = yaml.load(stream.read(), Loader=yaml.FullLoader)
+    embodiment = args["embodiment"]
+    if len(embodiment) == 1:
+        left_file = right_file = embodiments[embodiment[0]]["file_path"]
+        args["dual_arm_embodied"] = True
+    elif len(embodiment) == 3:
+        left_file = embodiments[embodiment[0]]["file_path"]
+        right_file = embodiments[embodiment[1]]["file_path"]
+        args["embodiment_dis"] = embodiment[2]
+        args["dual_arm_embodied"] = False
+    else:
+        raise ValueError("unsupported embodiment configuration")
+    args["left_robot_file"] = left_file
+    args["right_robot_file"] = right_file
+    args["left_embodiment_config"] = get_embodiment_config(left_file)
+    args["right_embodiment_config"] = get_embodiment_config(right_file)
+    head = cameras[args["camera"]["head_camera_type"]]
+    args["head_camera_h"] = head["h"]
+    args["head_camera_w"] = head["w"]
+    return class_decorator(task_name), args
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--task", required=True)
+    parser.add_argument("--task-config", default="demo_clean")
+    parser.add_argument("--instruction-type", default="unseen")
+    parser.add_argument("--start-seed", type=int, default=100000)
+    parser.add_argument("--count", type=int, choices=range(20, 31), default=20)
+    parser.add_argument("--max-raw-seeds", type=int)
+    parser.add_argument("--output", required=True, type=Path)
+    cli = parser.parse_args()
+
+    from description.utils.generate_episode_instructions import (
+        generate_episode_descriptions,
+    )
+    from envs.utils.create_actor import UnStableError
+    from script.test_render import Sapien_TEST
+
+    Sapien_TEST()
+    task_env, args = _build_environment(cli.task, cli.task_config)
+    pool = discover_seed_pool(
+        task_env,
+        args,
+        task_name=cli.task,
+        start_seed=cli.start_seed,
+        count=cli.count,
+        instruction_type=cli.instruction_type,
+        generate_descriptions=generate_episode_descriptions,
+        max_raw_seeds=cli.max_raw_seeds,
+        retry_exceptions=(UnStableError,),
+    )
+    cli.output.parent.mkdir(parents=True, exist_ok=True)
+    cli.output.write_text(json.dumps(pool, indent=2) + "\n", encoding="utf-8")
+    print(
+        f"{cli.task}: accepted {pool['candidate_count']} scenes from "
+        f"{pool['raw_seed_count']} raw seeds"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
