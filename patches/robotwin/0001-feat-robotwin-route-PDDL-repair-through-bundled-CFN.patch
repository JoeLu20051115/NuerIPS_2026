diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
index d16333b..2149681 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_execution.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -101,6 +101,38 @@ class RecedingHorizonMacroExecutorTest(unittest.TestCase):
 
         self.assertEqual(executed, list(range(50)))
 
+    def test_cfn_sampler_is_used_only_after_pddl_enters_repair(self):
+        samplers = []
+        executed = []
+
+        def base_sample(prompt, observation):
+            samplers.append(("pi05", prompt))
+            return list(range(50))
+
+        def repair_sample(prompt, observation):
+            samplers.append(("cfn", prompt))
+            return list(range(100, 150))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=base_sample,
+            sample_repair_actions=repair_sample,
+            take_action=executed.append,
+            observe=lambda: None,
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("ready node", "DAG_EXECUTION", 0)
+        executor.dispatch("local repair", "REPAIR", 0)
+
+        self.assertEqual(
+            samplers,
+            [("pi05", "ready node"), ("cfn", "local repair")],
+        )
+        self.assertEqual(executed[:50], list(range(50)))
+        self.assertEqual(executed[50:], list(range(100, 110)))
+
 
 if __name__ == "__main__":
     unittest.main()
