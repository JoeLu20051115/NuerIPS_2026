+    def load_repair_cfn(self, cfn_ckpt_path):
+        """Load the checkpoint-bundled CFN used only for PDDL local repair."""
+        from cfn.cfn_net import CFN
+
+        cfn = CFN(cfn_output_dim=20, cfn_hidden_dim=1536).to(
+            next(self.policy.parameters()).device
+        )
+        state = torch.load(cfn_ckpt_path, map_location="cpu", weights_only=True)
+        cfn.cfn.load_state_dict(state)
+        self.repair_cfn = cfn.cfn.eval()
+        generator = torch.Generator(device="cpu").manual_seed(42)
+        shape = (
+            50,
+            self.policy.model.config.n_action_steps,
+            self.policy.model.config.max_action_dim,
+        )
+        self.repair_noise = torch.randn(shape, generator=generator).to(
+            device=next(self.policy.parameters()).device,
+            dtype=next(self.policy.parameters()).dtype,
+        )
+
+    def get_repair_action(self):
+        """Select one of 50 frozen-pi0.5 samples with the frozen repair CFN."""
+        if self.repair_cfn is None or self.repair_noise is None:
+            raise RuntimeError("repair CFN is not loaded")
+        with torch.no_grad():
+            inputs = {
+                key: value.to(self.policy.config.device)
+                if isinstance(value, torch.Tensor)
+                else value
+                for key, value in self.observation_window.items()
+            }
+            for key in inputs:
+                if key == "task":
+                    inputs[key] = inputs[key] * 50
+                elif len(inputs[key].shape) in {2, 4}:
+                    inputs[key] = inputs[key].repeat(50, *([1] * (len(inputs[key].shape) - 1)))
+                else:
+                    raise ValueError(f"unsupported policy input shape for {key}")
+            inputs = self.preprocessor(inputs)
+            actions, features = self.policy.predict_action_chunk_and_get_feature(
+                inputs, self.repair_noise.clone()
+            )
+            actions = self.postprocessor(actions)
+            scores = self.repair_cfn(
+                features.to(next(self.repair_cfn.parameters()).dtype)
+            ).norm(dim=1)
+            selected = int(torch.argmin(scores).item())
+        return actions[selected].to(torch.float32).cpu().numpy()
+
     def reset_obsrvationwindows(self):
         self.instruction = None
         self.observation_window = None
