From 2d3fc450b90eeb135a895d6683706dfd5a49148a Mon Sep 17 00:00:00 2001
From: Du Hangyu <770240437@qq.com>
Date: Thu, 13 Aug 2026 11:07:47 +0800
Subject: [PATCH 2/3] feat(robotwin): verify every PDDL node with bundled CFN

---
 third_party/Robotwin/script/pi05_logiv_execution.py     | 3 ++-
 third_party/Robotwin/tests/test_pi05_logiv_execution.py | 6 +++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
index 7762a8b..6c8a261 100644
--- a/third_party/Robotwin/script/pi05_logiv_execution.py
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -48,7 +48,8 @@ class RecedingHorizonMacroExecutor:
             self._key = key
             sampler = (
                 self.sample_repair_actions
-                if mode == "REPAIR" and self.sample_repair_actions is not None
+                if mode in {"DAG_EXECUTION", "REPAIR"}
+                and self.sample_repair_actions is not None
                 else self.sample_actions
             )
             self._actions = list(sampler(prompt, self.observe()))[
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
index 2149681..37ce41c 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_execution.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -101,7 +101,7 @@ class RecedingHorizonMacroExecutorTest(unittest.TestCase):
 
         self.assertEqual(executed, list(range(50)))
 
-    def test_cfn_sampler_is_used_only_after_pddl_enters_repair(self):
+    def test_cfn_sampler_is_used_for_every_pddl_controlled_node(self):
         samplers = []
         executed = []
 
@@ -128,9 +128,9 @@ class RecedingHorizonMacroExecutorTest(unittest.TestCase):
 
         self.assertEqual(
             samplers,
-            [("pi05", "ready node"), ("cfn", "local repair")],
+            [("cfn", "ready node"), ("cfn", "local repair")],
         )
-        self.assertEqual(executed[:50], list(range(50)))
+        self.assertEqual(executed[:50], list(range(100, 150)))
         self.assertEqual(executed[50:], list(range(100, 110)))
 
 
-- 
