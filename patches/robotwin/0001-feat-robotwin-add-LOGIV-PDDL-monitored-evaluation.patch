+def _execute_logiv_chunk(TASK_ENV, model, observation, prompt, action_chunk_steps):
+    model.set_language(prompt)
+    input_rgb_arr, input_state = deploy_policy.encode_obs(observation)
+    model.update_observation_window(input_rgb_arr, input_state)
+    actions = model.get_action()[:action_chunk_steps]
+    for action in actions:
+        TASK_ENV.take_action(action)
+        if TASK_ENV.eval_success:
+            break
+        observation = TASK_ENV.get_obs()
+        input_rgb_arr, input_state = deploy_policy.encode_obs(observation)
+        model.update_observation_window(input_rgb_arr, input_state)
+    return TASK_ENV.get_obs()
+
+
+def eval_logiv_policy(
+    task_name,
+    TASK_ENV,
+    args,
+    model,
+    *,
+    accepted_seeds,
+    logiv_root,
+    val_binary,
+    action_chunk_steps,
+    max_gpt4o_retries,
+    save_dir,
+    video_size=None,
+    instruction_type=None,
+):
+    logiv_src = logiv_python_path(logiv_root)
+    if logiv_src not in sys.path:
+        sys.path.insert(0, logiv_src)
+    from pi05_libero_repro.logiv.gpt4o import Gpt4oClient
+    from pi05_libero_repro.logiv.robotwin import (
+        ROBOTWIN_TASKS,
+        RobotwinEpisodeController,
+        RobotwinFactGrounder,
+        RobotwinPddlPlanner,
+        bind_canonical_policy_prompt,
+    )
+
+    task = bind_canonical_policy_prompt(ROBOTWIN_TASKS[task_name])
+    client = Gpt4oClient.from_env(
+        timeout_seconds=45.0,
+        max_retries=max_gpt4o_retries,
+    )
+    grounder = RobotwinFactGrounder(client)
+    planner = RobotwinPddlPlanner(val_binary, timeout_seconds=5.0)
+    TASK_ENV.suc = 0
+    TASK_ENV.test_num = 0
+    args["eval_mode"] = True
+    clear_cache_freq = args["clear_cache_freq"]
+    event_path = Path(save_dir) / "logiv_events.jsonl"
+
+    for now_id, now_seed in enumerate(accepted_seeds):
+        render_freq = args["render_freq"]
+        args["render_freq"] = 0
+        try:
+            TASK_ENV.setup_demo(now_ep_num=now_id, seed=now_seed, is_test=True, **args)
+            episode_info = TASK_ENV.play_once()
+            expert_feasible = TASK_ENV.plan_success and TASK_ENV.check_success()
+            TASK_ENV.close_env()
+        except Exception:
+            TASK_ENV.close_env()
+            raise RuntimeError(
+                f"frozen accepted seed {now_seed} no longer passes expert setup"
+            ) from None
+        if not expert_feasible:
+            raise RuntimeError(
+                f"frozen accepted seed {now_seed} no longer passes expert feasibility"
+            )
+        args["render_freq"] = render_freq
+
+        TASK_ENV.setup_demo(now_ep_num=now_id, seed=now_seed, is_test=True, **args)
+        episode_info_list = [episode_info["info"]]
+        descriptions = generate_episode_descriptions(
+            task_name, episode_info_list, len(accepted_seeds)
+        )
+        instruction = np.random.choice(descriptions[0][instruction_type])
+        TASK_ENV.set_instruction(instruction=instruction)
+
+        if TASK_ENV.eval_video_path is not None:
+            ffmpeg = subprocess.Popen(
+                [
+                    "ffmpeg", "-y", "-loglevel", "error", "-f", "rawvideo",
+                    "-pixel_format", "rgb24", "-video_size", video_size,
+                    "-framerate", "10", "-i", "-", "-pix_fmt", "yuv420p",
+                    "-vcodec", "libx264", "-crf", "23",
+                    f"{TASK_ENV.eval_video_path}/episode{TASK_ENV.test_num}.mp4",
+                ],
+                stdin=subprocess.PIPE,
+            )
+            TASK_ENV._set_eval_video_ffmpeg(ffmpeg)
+
+        deploy_policy.reset_model(model)
+        observation = TASK_ENV.get_obs()
+        controller = RobotwinEpisodeController(
+            task,
+            planner,
+            grounder,
+            max_dispatches=(TASK_ENV.step_lim + action_chunk_steps - 1)
+            // action_chunk_steps,
+        )
+        try:
+            outcome = controller.run(
+                initial_observation=observation,
+                dispatch=lambda prompt: _execute_logiv_chunk(
+                    TASK_ENV, model, TASK_ENV.get_obs(), prompt, action_chunk_steps
+                ),
+                native_success=lambda: bool(TASK_ENV.eval_success),
+                budget_exhausted=lambda: TASK_ENV.take_action_cnt >= TASK_ENV.step_lim,
+            )
+        finally:
+            if TASK_ENV.eval_video_path is not None:
+                TASK_ENV._del_eval_video_ffmpeg()
+
+        record = {
+            "task": task_name,
+            "seed": now_seed,
+            "success": outcome.success,
+            "reason": outcome.reason,
+            "actions": TASK_ENV.take_action_cnt,
+            "dispatches": outcome.dispatches,
+            "gpt4o_requests": len(outcome.events),
+            "original_instruction": str(instruction),
+            "events": [
+                {
+                    "epoch": event.epoch,
+                    "active_stage_index": event.active_stage_index,
+                    "facts": {name: value.value for name, value in event.facts.items()},
+                    "certificate_sha256": event.plan.certificate_sha256,
+                    "val_valid": event.plan.valid,
+                }
+                for event in outcome.events
+            ],
+        }
+        with event_path.open("a", encoding="utf-8") as stream:
+            stream.write(json.dumps(record, sort_keys=True) + "\n")
+
+        if outcome.success:
+            TASK_ENV.suc += 1
+            print("\033[92mSuccess!\033[0m")
+        else:
+            print(f"\033[91mFail! {outcome.reason}\033[0m")
+        TASK_ENV.close_env(
+            clear_cache=((now_id + 1) % clear_cache_freq == 0)
+        )
+        if TASK_ENV.render_freq:
+            TASK_ENV.viewer.close()
+        TASK_ENV.test_num += 1
+        print(
+            f"LOGIV {task_name} | {TASK_ENV.suc}/{TASK_ENV.test_num} | "
+            f"seed={now_seed} | actions={record['actions']} | "
+            f"gpt4o={record['gpt4o_requests']}"
+        )
+    return accepted_seeds[-1] + 1, TASK_ENV.suc
+
+
 def eval_policy(task_name,
                 TASK_ENV,
                 args,
