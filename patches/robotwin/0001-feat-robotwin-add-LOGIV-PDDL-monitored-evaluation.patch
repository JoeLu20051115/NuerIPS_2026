@@ -0,0 +1,47 @@
+import unittest
+
+from script.pi05_logiv_options import logiv_python_path, resolve_logiv_options
+
+
+class LogivOptionsTest(unittest.TestCase):
+    def test_src_layout_package_path_is_explicit(self):
+        self.assertEqual(logiv_python_path("/repo"), "/repo/src")
+
+    def test_resolves_fixed_seed_and_monitor_options(self):
+        self.assertEqual(
+            resolve_logiv_options(
+                {
+                    "accepted_seeds": [100000, 100002],
+                    "test_num": 2,
+                    "logiv_root": "/repo",
+                    "val_binary": "/repo/Validate",
+                    "action_chunk_steps": 25,
+                    "max_gpt4o_retries": 3,
+                }
+            ),
+            ([100000, 100002], "/repo", "/repo/Validate", 25, 3),
+        )
+
+    def test_rejects_seed_drift_and_invalid_chunk(self):
+        common = {"logiv_root": "/repo", "val_binary": "/repo/Validate"}
+        with self.assertRaisesRegex(ValueError, "accepted_seeds"):
+            resolve_logiv_options(
+                {**common, "accepted_seeds": [100000], "test_num": 2}
+            )
+        with self.assertRaisesRegex(ValueError, "unique"):
+            resolve_logiv_options(
+                {**common, "accepted_seeds": [100000, 100000], "test_num": 2}
+            )
+        with self.assertRaisesRegex(ValueError, "action_chunk_steps"):
+            resolve_logiv_options(
+                {
+                    **common,
+                    "accepted_seeds": [100000],
+                    "test_num": 1,
+                    "action_chunk_steps": 0,
+                }
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
