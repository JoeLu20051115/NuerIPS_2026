diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
index 87908d6..8ff8ea9 100644
--- a/third_party/Robotwin/script/pi05_logiv_execution.py
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -2,6 +2,24 @@ from copy import deepcopy
 from pathlib import Path
 
 
+def serialize_gpt4o_call_records(records):
+    fields = (
+        "purpose",
+        "response_id",
+        "model",
+        "input_tokens",
+        "output_tokens",
+        "elapsed_seconds",
+        "retries",
+        "request_sha256",
+        "response_sha256",
+    )
+    return [
+        {field: getattr(record, field) for field in fields}
+        for record in records
+    ]
+
+
 def relativize_vlm_audit_records(records, save_dir):
     """Serialize audit paths without allowing an episode to escape its output."""
     root = Path(save_dir).resolve()
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
index a1f2865..20a716b 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_execution.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -1,16 +1,40 @@
 import unittest
 from pathlib import Path
 import tempfile
+from types import SimpleNamespace
 
 from script.pi05_logiv_execution import (
     RecedingHorizonMacroExecutor,
     attach_observer_view,
     collect_fresh_evidence,
     relativize_vlm_audit_records,
+    serialize_gpt4o_call_records,
 )
 
 
 class RecedingHorizonMacroExecutorTest(unittest.TestCase):
+    def test_gpt4o_call_records_keep_model_usage_and_hashes(self):
+        records = [
+            SimpleNamespace(
+                purpose="state_gate",
+                response_id="chatcmpl-1",
+                model="gpt-4o-2024-08-06",
+                input_tokens=100,
+                output_tokens=12,
+                elapsed_seconds=0.5,
+                retries=1,
+                request_sha256="a" * 64,
+                response_sha256="b" * 64,
+            )
+        ]
+
+        serialized = serialize_gpt4o_call_records(records)
+
+        self.assertEqual(serialized[0]["purpose"], "state_gate")
+        self.assertEqual(serialized[0]["model"], "gpt-4o-2024-08-06")
+        self.assertEqual(serialized[0]["input_tokens"], 100)
+        self.assertEqual(serialized[0]["request_sha256"], "a" * 64)
+
     def test_vlm_audit_records_are_confined_to_the_episode_output(self):
         with tempfile.TemporaryDirectory() as directory:
             root = Path(directory).resolve()
