 3 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
index eb0b1b2..9665c68 100644
--- a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
+++ b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
@@ -32,6 +32,7 @@ from script.pi05_logiv_execution import (
     attach_observer_view,
     collect_fresh_evidence,
     relativize_vlm_audit_records,
+    serialize_gpt4o_call_records,
 )
 
 from policy.pi05 import pi05_model_torch
@@ -351,6 +352,7 @@ def eval_logiv_policy(
             )
         instruction = accepted_instructions[now_id]
         TASK_ENV.set_instruction(instruction=instruction)
+        call_record_start = len(client.records)
         grounder = RobotwinFactGrounder(
             client,
             audit_dir=Path(save_dir) / "vlm_audit",
@@ -441,6 +443,9 @@ def eval_logiv_policy(
             if TASK_ENV.eval_video_path is not None:
                 TASK_ENV._del_eval_video_ffmpeg()
 
+        gpt4o_calls = serialize_gpt4o_call_records(
+            client.records[call_record_start:]
+        )
         record = {
             "task": task_name,
             "seed": now_seed,
@@ -448,7 +453,8 @@ def eval_logiv_policy(
             "reason": outcome.reason,
             "actions": TASK_ENV.take_action_cnt,
             "dispatches": outcome.dispatches,
-            "gpt4o_requests": len(outcome.events),
