diff --git a/third_party/Robotwin/tests/test_pi05_baseline_options.py b/third_party/Robotwin/tests/test_pi05_baseline_options.py
new file mode 100644
index 0000000..b2cc6dd
--- /dev/null
+++ b/third_party/Robotwin/tests/test_pi05_baseline_options.py
@@ -0,0 +1,55 @@
+import unittest
+from unittest import mock
+
+from script.pi05_baseline_options import resolve_baseline_options
+
+
+class BaselineOptionsTest(unittest.TestCase):
+    def test_resolves_explicit_baseline_options(self):
+        self.assertEqual(
+            resolve_baseline_options(
+                {
+                    "policy_path": "/checkpoints/pi05",
+                    "test_num": "10",
+                    "tokenizer_path": "/models/paligemma_tokenizer.model",
+                    "record_videos": False,
+                }
+            ),
+            ("/checkpoints/pi05", 10, "/models/paligemma_tokenizer.model", False),
+        )
+
+    def test_rejects_missing_checkpoint_and_nonpositive_trial_count(self):
+        with self.assertRaisesRegex(ValueError, "policy_path"):
+            resolve_baseline_options({"test_num": 10})
+        with self.assertRaisesRegex(ValueError, "test_num"):
+            resolve_baseline_options({"policy_path": "/checkpoints/pi05", "test_num": 0})
+
+
+class LocalTokenizerTest(unittest.TestCase):
+    @mock.patch("policy.pi05.pi05_model_torch.GemmaTokenizer")
+    def test_builds_local_gemma_tokenizer_override(self, tokenizer_class):
+        from policy.pi05.pi05_model_torch import _tokenizer_processor_kwargs
+
+        tokenizer = tokenizer_class.return_value
+        result = _tokenizer_processor_kwargs("/models/paligemma_tokenizer.model")
+
+        tokenizer_class.assert_called_once_with(
+            vocab_file="/models/paligemma_tokenizer.model",
+            add_bos_token=True,
+            add_eos_token=False,
+        )
+        self.assertEqual(
+            result,
+            {
+                "preprocessor_overrides": {
+                    "tokenizer_processor": {
+                        "tokenizer_name": None,
+                        "tokenizer": tokenizer,
+                    }
+                }
+            },
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
