diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
new file mode 100644
index 0000000..4546050
--- /dev/null
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -0,0 +1,40 @@
+class RecedingHorizonMacroExecutor:
+    """Observe repairs frequently without truncating a stable pi0.5 macro."""
+
+    def __init__(
+        self,
+        *,
+        sample_actions,
+        take_action,
+        observe,
+        native_success,
+        base_chunk_steps,
+        repair_observation_steps,
+    ):
+        self.sample_actions = sample_actions
+        self.take_action = take_action
+        self.observe = observe
+        self.native_success = native_success
+        self.base_chunk_steps = int(base_chunk_steps)
+        self.repair_observation_steps = int(repair_observation_steps)
+        self._key = None
+        self._actions = []
+
+    def dispatch(self, prompt, mode, active_frontier):
+        key = (str(prompt), str(mode), active_frontier)
+        if key != self._key or not self._actions:
+            self._key = key
+            self._actions = list(self.sample_actions(prompt, self.observe()))[
+                : self.base_chunk_steps
+            ]
+        steps = (
+            self.base_chunk_steps
+            if mode == "BASE_MONITORED"
+            else self.repair_observation_steps
+        )
+        for _ in range(min(steps, len(self._actions))):
+            self.take_action(self._actions.pop(0))
+            if self.native_success():
+                self._actions.clear()
+                break
+        return self.observe()
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
new file mode 100644
index 0000000..8ec017d
--- /dev/null
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -0,0 +1,58 @@
+import unittest
+
+from script.pi05_logiv_execution import RecedingHorizonMacroExecutor
+
+
+class RecedingHorizonMacroExecutorTest(unittest.TestCase):
+    def test_reuses_macro_until_frontier_changes(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            start = len(samples) * 100
+            return list(range(start, start + 50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: len(executed),
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("grasp", "REPAIR", 0)
+        executor.dispatch("grasp", "REPAIR", 0)
+        executor.dispatch("handover", "REPAIR", 1)
+
+        self.assertEqual(len(samples), 2)
+        self.assertEqual(executed[:20], list(range(100, 120)))
+        self.assertEqual(executed[20:], list(range(200, 210)))
+
+    def test_mode_change_starts_a_new_certified_macro(self):
+        samples = []
+        executed = []
+
+        def sample(prompt, observation):
+            samples.append((prompt, observation))
+            return list(range(50))
+
+        executor = RecedingHorizonMacroExecutor(
+            sample_actions=sample,
+            take_action=executed.append,
+            observe=lambda: None,
+            native_success=lambda: False,
+            base_chunk_steps=50,
+            repair_observation_steps=10,
+        )
+
+        executor.dispatch("same prompt", "BASE_MONITORED", 0)
+        executor.dispatch("same prompt", "REPAIR", 0)
+
+        self.assertEqual(len(samples), 2)
+        self.assertEqual(len(executed), 60)
+
+
+if __name__ == "__main__":
+    unittest.main()
-- 
