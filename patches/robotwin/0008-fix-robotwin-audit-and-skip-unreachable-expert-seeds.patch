From ddc6ff6ac31b21fba015b5232038d52be1d75808 Mon Sep 17 00:00:00 2001
From: Du Hangyu <770240437@qq.com>
Date: Mon, 17 Aug 2026 12:01:13 +0800
Subject: [PATCH 8/9] fix(robotwin): audit and skip unreachable expert seeds

---
 .../Robotwin/script/discover_logiv_seed_pool.py    | 14 ++++++++++++--
 .../tests/test_discover_logiv_seed_pool.py         | 10 ++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/third_party/Robotwin/script/discover_logiv_seed_pool.py b/third_party/Robotwin/script/discover_logiv_seed_pool.py
index 0512832..9b06a88 100644
--- a/third_party/Robotwin/script/discover_logiv_seed_pool.py
+++ b/third_party/Robotwin/script/discover_logiv_seed_pool.py
@@ -48,12 +48,14 @@ def discover_seed_pool(
     if limit < count:
         raise ValueError("max_raw_seeds must be at least count")
     candidates = []
+    rejections = []
     seed = int(start_seed)
     scanned = 0
     while len(candidates) < count and scanned < limit:
         current = seed
         seed += 1
         scanned += 1
+        rejection_reason = None
         try:
             task_env.setup_demo(
                 now_ep_num=len(candidates),
@@ -63,12 +65,19 @@ def discover_seed_pool(
             )
             episode = task_env.play_once()
             accepted = bool(task_env.plan_success and task_env.check_success())
-        except retry_exceptions:
+        except retry_exceptions as error:
             accepted = False
             episode = None
+            rejection_reason = f"EXPERT_EXCEPTION:{type(error).__name__}"
         finally:
             task_env.close_env()
         if not accepted:
+            rejections.append(
+                {
+                    "seed": current,
+                    "reason": rejection_reason or "EXPERT_FAILED",
+                }
+            )
             continue
         info = episode.get("info", {})
         instruction = _instruction_for_scene(
@@ -96,6 +105,7 @@ def discover_seed_pool(
         "candidate_count": len(candidates),
         "raw_seed_count": scanned,
         "instruction_type": instruction_type,
+        "rejections": rejections,
         "candidates": candidates,
     }
 
@@ -169,7 +179,7 @@ def main() -> int:
         instruction_type=cli.instruction_type,
         generate_descriptions=generate_episode_descriptions,
         max_raw_seeds=cli.max_raw_seeds,
-        retry_exceptions=(UnStableError,),
+        retry_exceptions=(UnStableError, AssertionError),
     )
     cli.output.parent.mkdir(parents=True, exist_ok=True)
     cli.output.write_text(json.dumps(pool, indent=2) + "\n", encoding="utf-8")
diff --git a/third_party/Robotwin/tests/test_discover_logiv_seed_pool.py b/third_party/Robotwin/tests/test_discover_logiv_seed_pool.py
index c739a5f..8a92392 100644
--- a/third_party/Robotwin/tests/test_discover_logiv_seed_pool.py
+++ b/third_party/Robotwin/tests/test_discover_logiv_seed_pool.py
@@ -13,6 +13,8 @@ class DiscoverLogivSeedPoolTest(unittest.TestCase):
 
             def setup_demo(self, **kwargs):
                 self.seed = kwargs["seed"]
+                if self.seed == 100001:
+                    raise AssertionError("unreachable expert pose")
                 self.plan_success = self.seed % 2 == 0
 
             def play_once(self):
@@ -39,6 +41,7 @@ class DiscoverLogivSeedPoolTest(unittest.TestCase):
             count=3,
             instruction_type="unseen",
             generate_descriptions=descriptions,
+            retry_exceptions=(AssertionError,),
         )
 
         self.assertEqual(
@@ -51,6 +54,13 @@ class DiscoverLogivSeedPoolTest(unittest.TestCase):
         )
         self.assertEqual(pool["raw_seed_count"], 5)
         self.assertEqual(env.closed, [100000, 100001, 100002, 100003, 100004])
+        self.assertEqual(
+            pool["rejections"],
+            [
+                {"seed": 100001, "reason": "EXPERT_EXCEPTION:AssertionError"},
+                {"seed": 100003, "reason": "EXPERT_FAILED"},
+            ],
+        )
 
 
 if __name__ == "__main__":
-- 
2.43.0

