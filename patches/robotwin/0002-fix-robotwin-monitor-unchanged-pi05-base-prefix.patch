From fb3fe75f75a443e05c8b917582bfa8cbc22aa572 Mon Sep 17 00:00:00 2001
From: Du Hangyu <770240437@qq.com>
Date: Thu, 13 Aug 2026 00:21:33 +0800
Subject: [PATCH 2/4] fix(robotwin): monitor unchanged pi05 base prefix

---
 .../script/eval_lerobot_torch_pi05.py         | 18 ++++++++++++----
 .../Robotwin/script/pi05_logiv_options.py     | 12 +++++++++++
 .../Robotwin/tests/test_pi05_logiv_options.py | 21 ++++++++++++++++++-
 3 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
index c217a39..792eb1b 100644
--- a/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
+++ b/third_party/Robotwin/script/eval_lerobot_torch_pi05.py
@@ -92,7 +92,7 @@ def main(usr_args):
         args = yaml.load(f.read(), Loader=yaml.FullLoader)
 
     policy_path, test_num, tokenizer_path, record_videos = resolve_baseline_options(usr_args)
-    accepted_seeds, logiv_root, val_binary, action_chunk_steps, max_gpt4o_retries = (
+    accepted_seeds, accepted_instructions, logiv_root, val_binary, action_chunk_steps, max_gpt4o_retries, base_stall_observations = (
         resolve_logiv_options(usr_args)
     )
     args["eval_video_log"] = record_videos
@@ -194,10 +194,12 @@ def main(usr_args):
         args,
         model,
         accepted_seeds=accepted_seeds,
+        accepted_instructions=accepted_instructions,
         logiv_root=logiv_root,
         val_binary=val_binary,
         action_chunk_steps=action_chunk_steps,
         max_gpt4o_retries=max_gpt4o_retries,
+        base_stall_observations=base_stall_observations,
         save_dir=save_dir,
         video_size=video_size,
         instruction_type=instruction_type,
@@ -240,10 +242,12 @@ def eval_logiv_policy(
     model,
     *,
     accepted_seeds,
+    accepted_instructions,
     logiv_root,
     val_binary,
     action_chunk_steps,
     max_gpt4o_retries,
+    base_stall_observations,
     save_dir,
     video_size=None,
     instruction_type=None,
@@ -257,10 +261,9 @@ def eval_logiv_policy(
         RobotwinEpisodeController,
         RobotwinFactGrounder,
         RobotwinPddlPlanner,
-        bind_canonical_policy_prompt,
     )
 
-    task = bind_canonical_policy_prompt(ROBOTWIN_TASKS[task_name])
+    task = ROBOTWIN_TASKS[task_name]
     client = Gpt4oClient.from_env(
         timeout_seconds=45.0,
         max_retries=max_gpt4o_retries,
@@ -297,7 +300,11 @@ def eval_logiv_policy(
         descriptions = generate_episode_descriptions(
             task_name, episode_info_list, len(accepted_seeds)
         )
-        instruction = np.random.choice(descriptions[0][instruction_type])
+        instruction = (
+            accepted_instructions[now_id]
+            if accepted_instructions is not None
+            else np.random.choice(descriptions[0][instruction_type])
+        )
         TASK_ENV.set_instruction(instruction=instruction)
 
         if TASK_ENV.eval_video_path is not None:
@@ -321,6 +328,7 @@ def eval_logiv_policy(
             grounder,
             max_dispatches=(TASK_ENV.step_lim + action_chunk_steps - 1)
             // action_chunk_steps,
+            base_stall_observations=base_stall_observations,
         )
         try:
             outcome = controller.run(
@@ -330,6 +338,7 @@ def eval_logiv_policy(
                 ),
                 native_success=lambda: bool(TASK_ENV.eval_success),
                 budget_exhausted=lambda: TASK_ENV.take_action_cnt >= TASK_ENV.step_lim,
+                base_prompt=str(instruction),
             )
         finally:
             if TASK_ENV.eval_video_path is not None:
@@ -351,6 +360,7 @@ def eval_logiv_policy(
                     "facts": {name: value.value for name, value in event.facts.items()},
                     "certificate_sha256": event.plan.certificate_sha256,
                     "val_valid": event.plan.valid,
+                    "control_mode": event.control_mode,
                 }
                 for event in outcome.events
             ],
diff --git a/third_party/Robotwin/script/pi05_logiv_options.py b/third_party/Robotwin/script/pi05_logiv_options.py
index 569d0ab..a3edf8d 100644
--- a/third_party/Robotwin/script/pi05_logiv_options.py
+++ b/third_party/Robotwin/script/pi05_logiv_options.py
@@ -12,20 +12,32 @@ def resolve_logiv_options(usr_args):
         raise ValueError("accepted_seeds must contain exactly test_num entries")
     if len(set(accepted_seeds)) != len(accepted_seeds):
         raise ValueError("accepted_seeds must be unique")
+    accepted_instructions = usr_args.get("accepted_instructions")
+    if accepted_instructions is not None:
+        accepted_instructions = [str(value) for value in accepted_instructions]
+        if len(accepted_instructions) != test_num or not all(accepted_instructions):
+            raise ValueError(
+                "accepted_instructions must contain exactly test_num nonempty entries"
+            )
     logiv_root = usr_args.get("logiv_root")
     val_binary = usr_args.get("val_binary")
     if not logiv_root or not val_binary:
         raise ValueError("logiv_root and val_binary are required")
     action_chunk_steps = int(usr_args.get("action_chunk_steps", 50))
     max_gpt4o_retries = int(usr_args.get("max_gpt4o_retries", 2))
+    base_stall_observations = int(usr_args.get("base_stall_observations", 4))
     if action_chunk_steps < 1 or action_chunk_steps > 50:
         raise ValueError("action_chunk_steps must be in [1, 50]")
     if max_gpt4o_retries < 0:
         raise ValueError("max_gpt4o_retries must be nonnegative")
+    if base_stall_observations < 1:
+        raise ValueError("base_stall_observations must be positive")
     return (
         accepted_seeds,
+        accepted_instructions,
         str(logiv_root),
         str(val_binary),
         action_chunk_steps,
         max_gpt4o_retries,
+        base_stall_observations,
     )
