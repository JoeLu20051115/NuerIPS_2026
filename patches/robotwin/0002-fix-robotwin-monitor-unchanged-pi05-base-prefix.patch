+                    "accepted_instructions": ["first", "second"],
                 }
             ),
-            ([100000, 100002], "/repo", "/repo/Validate", 25, 3),
+            (
+                [100000, 100002],
+                ["first", "second"],
+                "/repo",
+                "/repo/Validate",
+                25,
+                3,
+                4,
+            ),
         )
 
     def test_rejects_seed_drift_and_invalid_chunk(self):
@@ -41,6 +51,15 @@ class LogivOptionsTest(unittest.TestCase):
                     "action_chunk_steps": 0,
                 }
             )
+        with self.assertRaisesRegex(ValueError, "accepted_instructions"):
+            resolve_logiv_options(
+                {
+                    **common,
+                    "accepted_seeds": [100000],
+                    "accepted_instructions": ["first", "extra"],
+                    "test_num": 1,
+                }
+            )
 
 
