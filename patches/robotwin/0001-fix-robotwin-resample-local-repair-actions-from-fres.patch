From 3779ac717b172af5277ee0bf9e60575cb9e8713d Mon Sep 17 00:00:00 2001
From: Du Hangyu <770240437@qq.com>
Date: Thu, 13 Aug 2026 08:10:48 +0800
Subject: [PATCH] fix(robotwin): resample local repair actions from fresh
 evidence

---
 third_party/Robotwin/script/pi05_logiv_execution.py     | 6 +++++-
 third_party/Robotwin/tests/test_pi05_logiv_execution.py | 9 +++++----
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/third_party/Robotwin/script/pi05_logiv_execution.py b/third_party/Robotwin/script/pi05_logiv_execution.py
index 00962a2..1e07fed 100644
--- a/third_party/Robotwin/script/pi05_logiv_execution.py
+++ b/third_party/Robotwin/script/pi05_logiv_execution.py
@@ -22,7 +22,11 @@ class RecedingHorizonMacroExecutor:
 
     def dispatch(self, prompt, mode, active_frontier):
         key = (str(prompt), str(mode), active_frontier)
-        if key != self._key or not self._actions:
+        # A repair dispatch is a receding-horizon local edit: after each
+        # observation boundary, sample a fresh short action prefix from the
+        # current image.  Replaying the unexecuted tail of the old 50-step
+        # macro ignores the very evidence that triggered local replanning.
+        if mode == "REPAIR" or key != self._key or not self._actions:
             self._key = key
             self._actions = list(self.sample_actions(prompt, self.observe()))[
                 : self.base_chunk_steps
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_execution.py b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
index 0ce9f97..996f7de 100644
--- a/third_party/Robotwin/tests/test_pi05_logiv_execution.py
+++ b/third_party/Robotwin/tests/test_pi05_logiv_execution.py
@@ -4,7 +4,7 @@ from script.pi05_logiv_execution import RecedingHorizonMacroExecutor
 
 
 class RecedingHorizonMacroExecutorTest(unittest.TestCase):
-    def test_reuses_macro_until_frontier_changes(self):
+    def test_repair_resamples_after_each_observation_boundary(self):
         samples = []
         executed = []
 
@@ -26,9 +26,10 @@ class RecedingHorizonMacroExecutorTest(unittest.TestCase):
         executor.dispatch("grasp", "REPAIR", 0)
         executor.dispatch("handover", "REPAIR", 1)
 
-        self.assertEqual(len(samples), 2)
-        self.assertEqual(executed[:20], list(range(100, 120)))
-        self.assertEqual(executed[20:], list(range(200, 210)))
+        self.assertEqual(len(samples), 3)
+        self.assertEqual(executed[:10], list(range(100, 110)))
+        self.assertEqual(executed[10:20], list(range(200, 210)))
+        self.assertEqual(executed[20:], list(range(300, 310)))
 
     def test_mode_change_starts_a_new_certified_macro(self):
         samples = []
-- 
2.43.0

