         args = yaml.load(f.read(), Loader=yaml.FullLoader)
 
     policy_path, test_num, tokenizer_path, record_videos = resolve_baseline_options(usr_args)
-    accepted_seeds, accepted_instructions, logiv_root, val_binary, action_chunk_steps, max_gpt4o_retries, base_stall_observations, stage_stall_observations = (
+    accepted_seeds, accepted_instructions, logiv_root, val_binary, action_chunk_steps, max_gpt4o_retries, base_stall_observations, stage_stall_observations, min_base_dispatches = (
         resolve_logiv_options(usr_args)
     )
     args["eval_video_log"] = record_videos
@@ -205,6 +205,7 @@ def main(usr_args):
         max_gpt4o_retries=max_gpt4o_retries,
         base_stall_observations=base_stall_observations,
         stage_stall_observations=stage_stall_observations,
+        min_base_dispatches=min_base_dispatches,
         save_dir=save_dir,
         video_size=video_size,
         instruction_type=instruction_type,
@@ -254,6 +255,7 @@ def eval_logiv_policy(
     max_gpt4o_retries,
     base_stall_observations,
     stage_stall_observations,
+    min_base_dispatches,
     save_dir,
     video_size=None,
     instruction_type=None,
@@ -325,6 +327,7 @@ def eval_logiv_policy(
             // action_chunk_steps,
             base_stall_observations=base_stall_observations,
             stage_stall_observations=stage_stall_observations,
+            min_base_dispatches=min_base_dispatches,
         )
         try:
             outcome = controller.run(
diff --git a/third_party/Robotwin/script/pi05_logiv_options.py b/third_party/Robotwin/script/pi05_logiv_options.py
index 752441e..ada29ea 100644
--- a/third_party/Robotwin/script/pi05_logiv_options.py
+++ b/third_party/Robotwin/script/pi05_logiv_options.py
@@ -37,6 +37,7 @@ def resolve_logiv_options(usr_args):
     action_chunk_steps = int(usr_args.get("action_chunk_steps", 50))
     max_gpt4o_retries = int(usr_args.get("max_gpt4o_retries", 2))
     base_stall_observations = int(usr_args.get("base_stall_observations", 4))
+    min_base_dispatches = int(usr_args.get("min_base_dispatches", 0))
     raw_stage_stalls = usr_args.get("stage_stall_observations")
     if isinstance(raw_stage_stalls, str):
         raw_stage_stalls = json.loads(raw_stage_stalls)
@@ -51,6 +52,8 @@ def resolve_logiv_options(usr_args):
         raise ValueError("max_gpt4o_retries must be nonnegative")
     if base_stall_observations < 1:
         raise ValueError("base_stall_observations must be positive")
+    if min_base_dispatches < 0:
+        raise ValueError("min_base_dispatches must be nonnegative")
     if stage_stall_observations is not None and (
         not stage_stall_observations
         or any(value < 1 for value in stage_stall_observations)
@@ -65,4 +68,5 @@ def resolve_logiv_options(usr_args):
         max_gpt4o_retries,
         base_stall_observations,
         stage_stall_observations,
+        min_base_dispatches,
     )
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_options.py b/third_party/Robotwin/tests/test_pi05_logiv_options.py
index dc7a96d..5cc2335 100644
