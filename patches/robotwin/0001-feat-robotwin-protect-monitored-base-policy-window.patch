                     "action_chunk_steps": 25,
                     "max_gpt4o_retries": 3,
                     "base_stall_observations": 4,
+                    "min_base_dispatches": 6,
                     "accepted_instructions": ["first", "second"],
                 }
             ),
@@ -68,6 +69,7 @@ class LogivOptionsTest(unittest.TestCase):
                 3,
                 4,
                 None,
+                6,
             ),
         )
 
@@ -83,7 +85,8 @@ class LogivOptionsTest(unittest.TestCase):
             }
         )
 
-        self.assertEqual(resolved[-1], [4, 4, 1])
+        self.assertEqual(resolved[-2], [4, 4, 1])
+        self.assertEqual(resolved[-1], 0)
 
     def test_rejects_seed_drift_and_invalid_chunk(self):
         common = {"logiv_root": "/repo", "val_binary": "/repo/Validate"}
