diff --git a/third_party/Robotwin/script/pi05_logiv_options.py b/third_party/Robotwin/script/pi05_logiv_options.py
index 50ded9e..752441e 100644
--- a/third_party/Robotwin/script/pi05_logiv_options.py
+++ b/third_party/Robotwin/script/pi05_logiv_options.py
@@ -1,3 +1,4 @@
+import json
 import os
 
 
@@ -36,12 +37,25 @@ def resolve_logiv_options(usr_args):
     action_chunk_steps = int(usr_args.get("action_chunk_steps", 50))
     max_gpt4o_retries = int(usr_args.get("max_gpt4o_retries", 2))
     base_stall_observations = int(usr_args.get("base_stall_observations", 4))
+    raw_stage_stalls = usr_args.get("stage_stall_observations")
+    if isinstance(raw_stage_stalls, str):
+        raw_stage_stalls = json.loads(raw_stage_stalls)
+    stage_stall_observations = (
+        None
+        if raw_stage_stalls is None
+        else [int(value) for value in raw_stage_stalls]
+    )
     if action_chunk_steps < 1 or action_chunk_steps > 50:
         raise ValueError("action_chunk_steps must be in [1, 50]")
     if max_gpt4o_retries < 0:
         raise ValueError("max_gpt4o_retries must be nonnegative")
     if base_stall_observations < 1:
         raise ValueError("base_stall_observations must be positive")
+    if stage_stall_observations is not None and (
+        not stage_stall_observations
+        or any(value < 1 for value in stage_stall_observations)
+    ):
+        raise ValueError("stage_stall_observations must contain positive values")
     return (
         accepted_seeds,
         accepted_instructions,
@@ -50,4 +64,5 @@ def resolve_logiv_options(usr_args):
         action_chunk_steps,
         max_gpt4o_retries,
         base_stall_observations,
+        stage_stall_observations,
     )
diff --git a/third_party/Robotwin/tests/test_pi05_logiv_options.py b/third_party/Robotwin/tests/test_pi05_logiv_options.py
