@@ -67,9 +67,24 @@ class LogivOptionsTest(unittest.TestCase):
                 25,
                 3,
                 4,
+                None,
             ),
         )
 
+    def test_resolves_stage_specific_stall_options(self):
+        resolved = resolve_logiv_options(
+            {
+                "accepted_seeds": [100000],
+                "accepted_instructions": ["instruction"],
+                "test_num": 1,
+                "logiv_root": "/repo",
+                "val_binary": "/repo/Validate",
+                "stage_stall_observations": "[4, 4, 1]",
+            }
+        )
+
+        self.assertEqual(resolved[-1], [4, 4, 1])
+
     def test_rejects_seed_drift_and_invalid_chunk(self):
         common = {"logiv_root": "/repo", "val_binary": "/repo/Validate"}
         with self.assertRaisesRegex(ValueError, "accepted_seeds"):
